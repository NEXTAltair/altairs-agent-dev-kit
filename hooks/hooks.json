{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_command}",
            "args": [
              "-I",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/plugin_entry.py",
              "hook_pre_commands.py",
              "PreToolUse"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${user_config.python_command}",
            "args": [
              "-I",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/plugin_entry.py",
              "hook_pre_pr_submodule_check.py",
              "PreToolUse"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_command}",
            "args": [
              "-I",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/plugin_entry.py",
              "hook_pre_edit_worktree.py",
              "PreToolUse"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_command}",
            "args": [
              "-I",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/plugin_entry.py",
              "hook_response_monitor.py",
              "Stop"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_command}",
            "args": [
              "-I",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/plugin_entry.py",
              "hook_worktree_create.py",
              "WorktreeCreate"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_command}",
            "args": [
              "-I",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/plugin_entry.py",
              "hook_worktree_remove.py",
              "WorktreeRemove"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
