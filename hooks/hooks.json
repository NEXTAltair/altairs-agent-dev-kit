{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook_pre_commands.py"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook_pre_pr_submodule_check.py"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook_pre_edit_worktree.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook_response_monitor.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook_worktree_create.py"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
